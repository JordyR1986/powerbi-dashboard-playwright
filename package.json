{
  "name": "powerbi-dashboard-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript test suite whose CI results feed a star schema and a Power BI quality dashboard.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=api --project=chromium",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "report": "playwright show-report",
    "docker:build": "docker build -t powerbi-dashboard-playwright .",
    "docker:test": "docker run --rm --ipc=host -e CI -v \"$PWD/playwright-report:/app/playwright-report\" -v \"$PWD/test-results:/app/test-results\" powerbi-dashboard-playwright"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "zod": "^4.6.7"
  }
}
